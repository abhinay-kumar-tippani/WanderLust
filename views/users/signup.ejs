<% layout("/layouts/boilerplate") %>
<div class="row mt-3 " >
    <div class="col-8 offset-2">
        <h3 class="mt-3 mb-2">SignUp for WanderLust</h3>
        <form action="/signup" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
                <label for="title" class="form-label">Username</label>
                <input name="username"type="text" class="form-control" placeholder="Add a username" required>
                <div class="invalid-feedback">Please enter a username!</div>
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input name="email"type="email" class="form-control" placeholder="Add an email" required>
                <div class="invalid-feedback">Please enter an email!</div>
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input name="password" type="password" class="form-control" required>
                <div class="invalid-feedback">Password should be valid</div>
            </div>
            <button class="btn btn-dark my-3 add-btn">SignUp</button>
        </form>
    </div>
</div>