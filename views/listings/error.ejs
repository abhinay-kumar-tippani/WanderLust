<style>
  .body {
    background: linear-gradient(to right, #f8f9fa, #e9ecef);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Segoe UI', sans-serif;
  }

  .error-card {
    background-color: #fff;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    text-align: center;
    max-width: 600px;
    width: 100%;
  }

  .error-icon {
    font-size: 3rem;
    color: #dc3545;
  }

  .error-message {
    font-size: 1.25rem;
    color: #6c757d;
  }

  .btn-group {
    margin-top: 1.5rem;
  }

  .btn-group a {
    margin: 0 0.5rem;
  }

</style>
  
<% layout("/layouts/boilerplate") %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
      <div class="card shadow-lg border-0 rounded-4 text-center p-5 bg-light">
        <div class="mb-4">
          <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 3rem;"></i>
        </div>
        <h2 class="text-danger fw-bold mb-3"><%= message %></h2>
        <div class="mt-4">
          <a href="javascript:history.back()" class="btn btn-secondary px-4 py-2 ms-2">
            <i class="bi bi-arrow-return-left"></i> Get Back
          </a>
        </div>
      </div>
    </div>
  </div>
</div>